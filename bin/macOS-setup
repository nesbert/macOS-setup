#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
SCRIPTS_DIR="${REPO_ROOT}/scripts"

usage() {
  cat <<'EOF'
Usage:
  ./bin/macOS-setup install
  ./bin/macOS-setup update
  ./bin/macOS-setup ghostty-shaders
  ./bin/macOS-setup system-settings
  ./bin/macOS-setup personal-settings
  ./bin/macOS-setup help

Commands:
  install            Bootstrap Homebrew, packages, dotfiles, and DX defaults
  update             Update Homebrew packages/casks and refresh vim config
  ghostty-shaders    Download shader repositories and configure Ghostty links
  system-settings    Apply DX-focused macOS system settings
  personal-settings  Apply personal macOS preferences
  help               Show this help message
EOF
}

check_github_ssh() {
  local ssh_output

  # GitHub typically returns a non-zero code for -T even on successful auth.
  if ssh_output="$(ssh -o BatchMode=yes -o ConnectTimeout=5 -T git@github.com 2>&1)"; then
    return 0
  fi

  if [[ "${ssh_output}" != *"successfully authenticated"* ]]; then
    echo "Error: Cannot connect to GitHub via SSH" >&2
    echo "Please verify your SSH configuration. See docs/ssh-keys.md for instructions." >&2
    exit 1
  fi
}

main() {
  local command="${1:-help}"

  # Skip SSH check for help command
  if [ "${command}" != "help" ] && [ "${command}" != "-h" ] && [ "${command}" != "--help" ]; then
    check_github_ssh
  fi

  case "${command}" in
    install)
      exec "${SCRIPTS_DIR}/macOS-install.sh"
      ;;
    update)
      exec "${SCRIPTS_DIR}/macOS-update.sh"
      ;;
    ghostty-shaders)
      exec "${SCRIPTS_DIR}/ghostty-shaders.sh"
      ;;
    system-settings)
      exec "${SCRIPTS_DIR}/macOS-system-settings.sh"
      ;;
    personal-settings)
      exec "${SCRIPTS_DIR}/macOS-personal-settings.sh"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      echo "Unknown command: ${command}" >&2
      echo >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
